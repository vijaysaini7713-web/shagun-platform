# Frontend (public, safe to expose — security comes from RLS)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_PUBLIC_BASE_URL=https://shagunbox.in

# Edge function secrets — set with `supabase secrets set`, NEVER in the frontend
# SUPABASE_SERVICE_ROLE_KEY is injected automatically in edge functions.
# SMS_PROVIDER=msg91|twilio|console
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# IP_HASH_SALT=long-random-string
# ALLOWED_ORIGINS=https://shagunbox.in,http://localhost:5173
